{
  "id": "ms-todo-provider",
  "name": "Microsoft To Do",
  "version": "0.1.0",
  "manifestVersion": 1,
  "minSupVersion": "18.20.0",
  "description": "Two-way sync Microsoft To Do tasks with Super Productivity (desktop)",
  "author": "zeit",
  "type": "issueProvider",
  "icon": "icon.svg",
  "iFrame": false,
  "permissions": ["oauth", "http", "nodeExecution"],
  "hooks": [],
  "nodeScriptConfig": {
    "timeout": 30000,
    "memoryLimit": "256MB"
  },
  "issueProvider": {
    "pollIntervalMs": 300000,
    "icon": "check_circle",
    "humanReadableName": "Microsoft To Do",
    "issueStrings": { "singular": "任务", "plural": "任务" },
    "defaultAutoAddToBacklog": false
  }
}
