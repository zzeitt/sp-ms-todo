{
  "id": "ms-todo-provider",
  "name": "Microsoft To Do",
  "version": "0.1.4",
  "manifestVersion": 1,
  "minSupVersion": "18.20.0",
  "description": "Two-way sync Microsoft To Do tasks with Super Productivity (desktop + mobile)",
  "author": "zeit",
  "type": "issueProvider",
  "icon": "icon.svg",
  "iFrame": true,
  "sidePanel": false,
  "isSkipMenuEntry": true,
  "uiKit": false,
  "permissions": [
    "http",
    "registerMenuEntry",
    "registerHeaderButton",
    "showIndexHtmlAsView"
  ],
  "allowedHosts": ["graph.microsoft.com", "login.microsoftonline.com"],
  "hooks": [],
  "issueProvider": {
    "pollIntervalMs": 60000,
    "icon": "check_box",
    "humanReadableName": "Microsoft To Do",
    "issueStrings": { "singular": "任务", "plural": "任务" },
    "defaultAutoAddToBacklog": false
  }
}
